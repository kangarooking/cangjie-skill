---
import CinematicJourney from "@/components/CinematicJourney.astro";
import SkillCard from "@/components/SkillCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { filterCatalog, getCatalogStats, loadCatalog } from "@/lib/catalog";
import { canonicalUrl } from "@/lib/seo";
import { withBase } from "@/lib/urls";

const entries = filterCatalog(await loadCatalog(), {});
const stats = getCatalogStats(entries);
const featured = entries.filter((entry) => entry.featured).slice(0, 6);
const faqItems = [
  {
    question: "什么是 Agent Skill？",
    answer: "Agent Skill 是一套让 AI Agent 按需读取和执行的本地工作方法，通常由 SKILL.md、脚本、模板和参考资料组成。它把一次性的提示词，变成可安装、可复用、可验证的能力。",
  },
  {
    question: "仓颉 Skill 和普通提示词有什么不同？",
    answer: "普通提示词通常只服务于一次对话；仓颉 Skill 会保留触发条件、输入、步骤、边界和验收标准，让 Codex、Claude Code、Cursor 等 Agent 在真实任务中重复调用同一套方法。",
  },
  {
    question: "如何安装仓颉收录的 Agent Skills？",
    answer: "进入任意 Skill Pack 详情页，复制安装提示词并发送给你的 Agent。Agent 会读取统一安装规范、检查来源与风险、选择正确目录并验证安装结果。",
  },
  {
    question: "仓颉 Skill 收录哪些内容？",
    answer: "当前 Registry 覆盖投资、决策、写作、营销、认知、学习、AI 提示词等领域，内容来自可追溯的公开资料或开源仓库，并通过统一 Schema 公开审核。",
  },
];
const faqId = `${canonicalUrl("/")}#faq`;
---

<BaseLayout
  title="仓颉 Skill - Agent Skills 中文知识库与安装教程"
  description="仓颉 Skill 是开源 Agent Skills 中文知识库，把书籍、长视频、播客和课程蒸馏为可安装、可调用、可复用的 AI Agent 能力。浏览 Skill Packs、查看安装教程并参与共建。"
  schema={{ mainEntity: { "@id": faqId } }}
  extraSchema={[
    {
      "@type": "FAQPage",
      "@id": faqId,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ]}
>
  <CinematicJourney />

  <section class="registry-overview" id="registry-overview">
    <div class="shell registry-layout">
      <div class="registry-intro">
        <p class="eyebrow">Open Registry / Schema V1</p>
        <h2>不是知识陈列馆。<br />是 Agent 的方法仓库。</h2>
        <p>每个 Pack 都来自可追溯的公开来源，经过结构化与验证，再通过统一安装规范交给你的 Agent。</p>
        <a class="text-link" href={withBase("/skills")}>进入完整 Registry <span aria-hidden="true">↗</span></a>
      </div>
      <aside class="registry-ledger" aria-label="仓颉 Skill 数据概览">
        <div class="ledger-heading"><span>LIVE INDEX</span><span class="schema-state"><i></i> SCHEMA VALID</span></div>
        <dl>
          <div><dt>{stats.packs}</dt><dd>Skill Packs</dd></div>
          <div><dt>{stats.skills}</dt><dd>Atomic Skills</dd></div>
          <div><dt>{stats.domains}</dt><dd>Knowledge Domains</dd></div>
          <div><dt>{stats.contributors}</dt><dd>Contributors</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section process-section">
    <div class="shell">
      <div class="section-header">
        <div><p class="eyebrow">From registry to work</p><h2>找到、安装、开始工作</h2><p>目录知识、安装位置和兼容判断都交给 Agent；你只需要说清楚真实任务。</p></div>
        <a class="text-link" href={withBase("/learn")}>查看完整教程 →</a>
      </div>
      <ol class="steps-grid">
        <li><span>01 / DISCOVER</span><h3>选择 Skill Pack</h3><p>按领域、质量和使用场景，找到真正对应当前问题的方法。</p><i aria-hidden="true">检索</i></li>
        <li><span>02 / INSTALL</span><h3>交给 Agent 安装</h3><p>复制一条提示词。Agent 会检查来源、判断目录、处理冲突并验证结果。</p><i aria-hidden="true">安装</i></li>
        <li><span>03 / APPLY</span><h3>描述真实任务</h3><p>不用记命令。直接说明目标、背景和想要的结果，让 Skill 在工作中被调用。</p><i aria-hidden="true">调用</i></li>
      </ol>
    </div>
  </section>

  <section class="section featured-section">
    <div class="shell">
      <div class="section-header">
        <div><p class="eyebrow">Curated methods</p><h2>精选 Skill Packs</h2><p>从投资、认知、写作到 AI 提示词，先从经过验证的代表性成果开始。</p></div>
        <a class="text-link" href={withBase("/skills")}>查看全部 {stats.packs} 个 →</a>
      </div>
      <div class="skill-grid">
        {featured.map((entry) => <SkillCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section seo-faq-section">
    <div class="shell seo-faq-layout">
      <div class="seo-faq-intro">
        <p class="eyebrow">Agent Skills Guide</p>
        <h2>关于 Agent Skill，先回答四个问题</h2>
        <p>从“是什么”到“怎么安装”，先建立一条最短理解路径，再进入目录选择适合当前任务的 Skill Pack。</p>
        <a class="text-link" href={withBase("/learn")}>阅读完整安装与使用教程 →</a>
      </div>
      <div class="seo-faq-list">
        {faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section contribution-section">
    <div class="shell contribution-grid">
      <div>
        <p class="contribution-index">CONTRIBUTE / 001</p>
        <p class="eyebrow">Open Registry</p>
        <h2>好方法，值得被更多 Agent 调用</h2>
      </div>
      <div><p>不注册账号，也不进入黑箱后台。浏览器只在本地整理投稿文件，最终通过 GitHub Pull Request 公开审核、留下归属并自动进入网站。</p><div class="button-row"><a class="button paper" href={withBase("/submit")}>提交一个 Skill ↗</a><a class="button outline-light" href="https://github.com/kangarooking/cangjie-skill" target="_blank" rel="noreferrer">查看审核规则</a></div></div>
    </div>
  </section>
</BaseLayout>

<style>
  .registry-overview { position: relative; scroll-margin-top: calc(var(--header-height) + 20px); overflow: hidden; padding: clamp(76px, 9vw, 124px) 0; background: linear-gradient(180deg, #f4fbff, #fffdf7); }
  .registry-overview::before { content: ""; position: absolute; width: 310px; height: 125px; right: -65px; top: 48px; border-radius: 999px; background: rgba(117,201,245,.13); transform: rotate(-8deg); }
  .registry-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(390px, .82fr); gap: clamp(55px, 9vw, 132px); align-items: end; }
  .registry-intro h2 { max-width: 720px; margin: 0; font-family: var(--font-display); font-size: clamp(42px, 5.5vw, 70px); font-weight: 900; line-height: 1.09; letter-spacing: -.055em; text-shadow: 0 3px white; }
  .registry-intro > p:not(.eyebrow) { max-width: 610px; margin: 24px 0 27px; color: var(--muted); font-size: 17px; }
  .registry-ledger { position: relative; padding: 24px; border: 4px solid white; border-radius: 30px; background: linear-gradient(150deg, #ffffff, #ecf8ff); box-shadow: var(--shadow-pop), inset 0 0 0 1px rgba(75,143,182,.14); transform: rotate(1deg); }
  .registry-ledger::after { content: ""; position: absolute; width: 58px; height: 21px; left: 50%; top: -13px; border-radius: 8px; background: rgba(255,207,108,.7); box-shadow: inset 0 1px rgba(255,255,255,.65); transform: translateX(-50%) rotate(-2deg); }
  .ledger-heading { display: flex; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid var(--line); color: var(--muted); font: 10px var(--font-mono); letter-spacing: .09em; }
  .schema-state { color: var(--jade); }
  .schema-state i { display: inline-block; width: 7px; height: 7px; margin-right: 5px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px rgba(56,174,120,.13); }
  .registry-ledger dl { display: grid; grid-template-columns: 1fr 1fr; margin: 0; }
  .registry-ledger dl div { padding: 21px 0 17px; border-bottom: 1px solid var(--line); }
  .registry-ledger dl div:nth-child(odd) { border-right: 1px solid var(--line); }
  .registry-ledger dl div:nth-child(even) { padding-left: 22px; }
  .registry-ledger dt { font-family: var(--font-display); font-size: 39px; font-weight: 900; line-height: 1; letter-spacing: -.04em; }
  .registry-ledger dl div:nth-child(1) dt { color: #2d9bcf; }
  .registry-ledger dl div:nth-child(2) dt { color: var(--accent); }
  .registry-ledger dl div:nth-child(3) dt { color: var(--jade); }
  .registry-ledger dl div:nth-child(4) dt { color: #8b6ccc; }
  .registry-ledger dd { margin: 7px 0 0; color: var(--muted); font: 10px var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
  .process-section { overflow: hidden; background: linear-gradient(145deg, #dff5ff 0%, #effaff 56%, #fff7de 100%); }
  .process-section::after { content: ""; position: absolute; width: 420px; height: 420px; left: -240px; bottom: -250px; border: 50px solid rgba(117,201,245,.18); border-radius: 50%; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .steps-grid li { position: relative; min-height: 300px; overflow: hidden; padding: 28px; border: 3px solid white; border-radius: 28px; background: rgba(255,255,255,.82); box-shadow: var(--shadow-soft), inset 0 1px white; }
  .steps-grid li:nth-child(2) { transform: translateY(16px); }
  .steps-grid span { color: var(--cinnabar); font: 10px var(--font-mono); letter-spacing: .07em; }
  .steps-grid h3 { margin: 94px 0 10px; font-family: var(--font-display); font-size: 25px; font-weight: 900; }
  .steps-grid p { max-width: 300px; margin: 0; color: var(--muted); font-size: 14px; }
  .steps-grid i { position: absolute; display: grid; place-items: center; width: 78px; height: 78px; left: 28px; top: 62px; border-radius: 24px; color: white; background: linear-gradient(145deg, #80d7ff, #4fb3e6); box-shadow: 0 10px 22px rgba(49,145,194,.22), inset 0 2px rgba(255,255,255,.46); font-family: var(--font-display); font-size: 17px; font-style: normal; font-weight: 900; transform: rotate(-5deg); }
  .steps-grid li:nth-child(2) i { background: linear-gradient(145deg, #ffcF6b, #f2a638); box-shadow: 0 10px 22px rgba(214,148,50,.22), inset 0 2px rgba(255,255,255,.46); transform: rotate(4deg); }
  .steps-grid li:nth-child(3) i { background: linear-gradient(145deg, #7dde9f, #3db978); box-shadow: 0 10px 22px rgba(45,155,107,.22), inset 0 2px rgba(255,255,255,.46); }
  .featured-section { background: linear-gradient(180deg, #fffdf8, #f5fbff); }
  .seo-faq-section { background: linear-gradient(145deg, #e8f7ff 0%, #f7fcff 52%, #fff7dc 100%); }
  .seo-faq-layout { display: grid; grid-template-columns: minmax(0, .75fr) minmax(420px, 1fr); gap: clamp(48px, 8vw, 112px); align-items: start; }
  .seo-faq-intro { position: sticky; top: 110px; }
  .seo-faq-intro h2 { max-width: 560px; margin: 0; font-family: var(--font-display); font-size: clamp(36px, 4.6vw, 58px); font-weight: 900; line-height: 1.08; letter-spacing: -.045em; }
  .seo-faq-intro > p:not(.eyebrow) { max-width: 540px; margin: 22px 0 25px; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .seo-faq-list { display: grid; gap: 12px; }
  .seo-faq-list details { padding: 20px 22px; border: 3px solid white; border-radius: 22px; background: rgba(255,255,255,.88); box-shadow: var(--shadow-soft); }
  .seo-faq-list summary { cursor: pointer; color: var(--ink); font-family: var(--font-display); font-size: 18px; font-weight: 900; }
  .seo-faq-list p { margin: 14px 0 0; color: var(--muted); font-size: 14px; line-height: 1.8; }
  .contribution-section { overflow: hidden; color: white; background: linear-gradient(135deg, #1f5072, #12324e); }
  .contribution-section::before { content: ""; position: absolute; width: 520px; height: 520px; right: -180px; top: -300px; border-radius: 50%; background: radial-gradient(circle at 40% 40%, rgba(255,200,87,.58), rgba(246,107,59,.2) 42%, transparent 70%); }
  .contribution-section::after { content: ""; position: absolute; width: 180px; height: 70px; left: 8%; bottom: 20px; border-radius: 999px; background: rgba(255,255,255,.05); }
  .contribution-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(60px, 10vw, 150px); align-items: end; }
  .contribution-index { margin: 0 0 65px; color: rgba(255,255,255,.38); font: 10px var(--font-mono); letter-spacing: .09em; }
  .contribution-grid h2 { max-width: 610px; margin: 0; color: white; font-family: var(--font-display); font-size: clamp(38px, 5vw, 60px); font-weight: 900; line-height: 1.08; letter-spacing: -.045em; text-shadow: 0 4px 16px rgba(9,30,47,.22); }
  .contribution-grid > div:last-child > p { margin: 0; color: rgba(255,255,255,.68); font-size: 16px; line-height: 1.8; }
  .button.paper { background: linear-gradient(145deg, #ff895b, #ef5d32); color: white; }
  .button.outline-light { border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.08); color: white; backdrop-filter: blur(10px); }
  @media (max-width: 820px) {
    .registry-layout, .seo-faq-layout, .contribution-grid { grid-template-columns: 1fr; gap: 48px; }
    .registry-ledger { max-width: 520px; }
    .seo-faq-intro { position: static; }
    .contribution-index { margin-bottom: 35px; }
  }
  @media (max-width: 620px) {
    .steps-grid { grid-template-columns: 1fr; }
    .steps-grid li, .steps-grid li + li { min-height: 235px; padding: 24px; }
    .steps-grid li:nth-child(2) { transform: none; }
    .steps-grid h3 { margin-top: 92px; }
  }
</style>
